# ==========================================
# YT-AGENT CONFIGURATION
# ==========================================

# YouTube Channel API Credentials (Optional - for direct auto-upload)
# Get credentials at: https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_CHANNEL_ID=
YOUTUBE_PRIVACY=unlisted # 'private', 'unlisted', or 'public'

# AI Lyrics & Image APIs (Optional - system includes built-in high-res procedural engines that work 100% free with 0 keys!)
GEMINI_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Autopilot Cron Scheduling
# Default: 10:00 AM on Monday, Wednesday, Friday ("0 10 * * 1,3,5")
AUTOPILOT_CRON=0 10 * * 1,3,5
AUTOPILOT_AUTO_PUBLISH=false # Set to true to upload automatically upon each scheduled run
